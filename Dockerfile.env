# PAN-Crafter 실행 **환경만** 담은 이미지. 코드와 연구 기록은 들어 있지 않다.
#
#   docker pull hojunqueen/pancrafter-env:latest
#   git clone <private repo> PAN-Crafter && cd PAN-Crafter
#   docker run --gpus all -it --rm \
#       -v "$PWD":/workspace \
#       -v /path/to/PanCollection:/workspace/data/PanCollection \
#       hojunqueen/pancrafter-env ./tools/run.sh wv3
#
# 코드를 마운트하는 구조라 **코드가 바뀌어도 이미지를 다시 만들 필요가 없다.**
# 이미지는 의존성이 바뀔 때만 갱신한다.
#
# 커스텀 CUDA 확장이 없으므로 빌드 중 컴파일이 없다.

FROM pytorch/pytorch:2.4.0-cuda11.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# git 은 DLPan-Toolbox clone 용, libgl/libglib 은 opencv 런타임 의존이다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# torch/torchvision 은 베이스 이미지에 이미 있으므로 제외하고 설치한다.
COPY requirements.txt /tmp/requirements.txt
RUN grep -vE "^(torch|torchvision)==" /tmp/requirements.txt > /tmp/req.txt \
    && pip install --no-cache-dir -r /tmp/req.txt \
    && rm /tmp/req.txt /tmp/requirements.txt

# full-resolution 지표(D_lambda/D_s/HQNR)가 쓰는 MTF/interp23tap 구현.
# GPL-3.0 이라 저장소에 편입하지 않고 별도 프로그램으로 둔다(단순 병치).
ARG WITH_DLPAN=1
RUN if [ "$WITH_DLPAN" = "1" ]; then \
        git clone --depth 1 https://github.com/liangjiandeng/DLPan-Toolbox.git /opt/DLPan-Toolbox \
        && rm -rf /opt/DLPan-Toolbox/.git; \
    fi
ENV PANCRAFTER_DLPAN=/opt/DLPan-Toolbox

# 마운트한 저장소를 import 할 수 있게 한다.
ENV PYTHONPATH=/workspace

LABEL org.opencontainers.image.title="pancrafter-env" \
      org.opencontainers.image.description="Runtime environment for PAN-Crafter reproduction (code mounted, not baked in)" \
      org.opencontainers.image.licenses="MIT"

CMD ["/bin/bash"]
