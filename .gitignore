# datasets (CANConv/data/datasets 로 향하는 심볼릭 링크 + 저자 배포 _pan.h5)
data/

# 학습 산출물 (work_dir/<실험>/meta/ 에 실행 조건이 남는다)
work_dir/
runs/
*.mat

# results_log 는 추적한다. 문서와 그림 모두 git 에 올린다.
!results_log/

# pan_h5.zip 압축 해제본 (data/ 로 복사되어 사용됨)
pan_h5/extracted/

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# 에디터
.vscode/

# 진행 중 실험 로그 (work_dir/ 는 이미 제외됨)
*.log
account.json
# gspread 서비스 계정 키와 프로파일 캐시
gspread/account.json
gspread/_profile_cache.json
# 서버 식별자는 머신마다 다르다 (s1/s2). 저장소로 옮기면 안 된다
gspread/server.txt

# UVS teacher cache (0.7 GB, 서버별로 tools/uvs_build_cache.py 로 생성)
outputs/uvs_cache/*.npz

# Shared code/docs must not accidentally publish server-local model/data/key files.
# Existing tracked fixtures remain tracked; no local files are removed here.
*.pt
*.pth
*.safetensors
*.h5
*.hdf5
*.onnx
.env
.env.local
*.pem
*.key
credentials.json
token.json
# Git worktree registration backups are local recovery metadata, not source releases.
/storage/**/*.git-registration.tar.gz
# One server-local, generated 40-step PO10 smoke config; not an experiment recipe.
/config/_po10_gate_N3.yaml
